# Copy to .env and fill in. Never commit .env.
#
# The agent talks to ANY OpenAI-compatible Chat Completions endpoint.
# Switching models/providers = editing these 3 lines, no code changes.

# --- Option A: OpenAI ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
# Placeholder: replace <openai-model> with the model name you will use. LLM_MODEL has no default.
LLM_MODEL=<openai-model>

# --- Option B: local model via Ollama (no key needed; any non-empty string works) ---
# Ollama's default context window (4096 tokens) is smaller than the agent's first
# prompt, so build a 32k-context variant once:
#   ollama create buyer-qwen3.5-4b -f ollama/Modelfile.qwen3.5-4b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=buyer-qwen3.5-4b

# Optional. Leave unset for models that only accept their default temperature.
# LLM_TEMPERATURE=0

# Optional. Some OpenAI reasoning models refuse tool calls on /v1/chat/completions
# unless reasoning is off; set this to "none" for them. Leave unset for Ollama.
# LLM_REASONING_EFFORT=none

# Optional. Seconds to wait for one model reply (default 120). Local thinking models may need 300+.
# LLM_TIMEOUT_S=300

# Optional. Cap on tokens per model reply (default 4096); stops a model that loops forever.
# LLM_MAX_TOKENS=4096
